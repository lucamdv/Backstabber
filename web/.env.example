# Browser settings. Use only the project's publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=/api/v1

# Node server settings. Never prefix the database URL with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
BACKSTABBER_API_PORT=8787
# Comma-separated frontend origins, only needed for a cross-origin API.
BACKSTABBER_ALLOWED_ORIGIN=
