{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/v1/:path*", "destination": "/api/index?__route=:path*" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ]
}
